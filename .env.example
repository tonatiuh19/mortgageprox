# Copy to .env. Never commit .env.

PUBLIC_APP_URL=http://localhost:8080
JWT_SECRET=change_me_random_64_chars

DB_HOST=gateway01.example.prod.aws.tidbcloud.com
DB_PORT=4000
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=mortgageprox
DB_SSL=true

RESEND_API_KEY=re_xxxxxxxx
SMTP_FROM=MortgageProx <no-reply@disruptinglabs.com>

# Vitest always dry-runs email. Set this before clicking through flows on npm run dev
# if you do not want real messages.
# NOTIFY_SANDBOX=true

CRON_SECRET=change_me_random_64_chars

# Microsoft 365 mailbox connect. Leave blank until the Azure app exists.
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_REDIRECT_URI=http://localhost:8081/api/public/microsoft/callback

# Vercel Blob. Letters, profile images, and documents. Same store in development and production.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxx
BLOB_STORE_ID=store_xxxxxxxx
BLOB_WEBHOOK_PUBLIC_KEY=

# Twilio add-on. Texts and click-to-call use the office number.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=

# Deploy kit (local only, never on Vercel): Telegram questions and alerts for npm run deploy:prod.
# The chat id is saved on first use. Optional name on the messages and the test dashboard.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DEPLOY_NAME=
